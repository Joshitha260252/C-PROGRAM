#include <stdio.h>
void main()
{
    int heads=6;
    int legs=16;
    int cows,hens;
    int flag=0;
    for(cows=0;cows<=heads;cows++)
        {
            hens=heads-cows;
            if(cows*4+hens*2==legs)
            {
                flag=1;
                break;
            }
            
        }
    if(flag==1)
        printf("cows=%d hens=%d",cows,hens);
}
