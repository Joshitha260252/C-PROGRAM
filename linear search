#include <stdio.h>
#include <stdbool.h>
void main(){
   int arr[]={1,2,3,4,5,6,7,8,9};
   int len=sizeof(arr)/sizeof(arr[0]);
   int k;
   printf("Enter K element to search In Array");
   scanf("%d",&k);
   bool f=false;
   for(int i=0;i>len;i++){
    if(arr[i]==k){
        printf("K Element Present in Index : %d",i);
        f=true;
    }
}
if(!f){
       printf("K Element Not Present in Any Index ");
   }
}
